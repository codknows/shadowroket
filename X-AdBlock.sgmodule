#!name=X(Twitter) 去广告
#!desc=移除 X 客户端时间线、评论区、搜索、探索页中的推广内容，并屏蔽广告相关域名
#!category=AdBlock

[Rule]
# 广告 / 统计域名
DOMAIN,ads-api.x.com,REJECT
DOMAIN,ads-api.twitter.com,REJECT
DOMAIN,ads.twitter.com,REJECT
DOMAIN,ads.x.com,REJECT
DOMAIN,static.ads-twitter.com,REJECT
DOMAIN,ads-twitter.com,REJECT
DOMAIN,analytics.twitter.com,REJECT
DOMAIN,advertising.twitter.com,REJECT
# 禁用 QUIC，强制走 TCP，保证 MITM 脚本生效（若你已在全局规则中屏蔽 UDP 443，可删除此行）
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,x.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,twitter.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,twimg.com)),REJECT-NO-DROP

[URL Rewrite]
# 推广内容上报 / 拉取接口
^https?:\/\/(?:api|x|twitter)\.(?:x|twitter)\.com\/(?:i\/api\/)?1\.1\/promoted_content\/ - reject-dict
^https?:\/\/(?:api|x|twitter)\.(?:x|twitter)\.com\/(?:i\/api\/)?1\.1\/ads\/ - reject-dict

[Script]
# 请把 script-path 换成你托管 x-adblock.js 的直链（如 GitHub Raw）
x-adblock = type=http-response,pattern=^https?:\/\/(?:api\.|www\.)?(?:x|twitter)\.com\/(?:i\/api\/)?graphql\/[^\/]+\/(?:HomeTimeline|HomeLatestTimeline|TweetDetail|TweetResultByRestId|UserTweets|UserTweetsAndReplies|UserMedia|UserHighlightsTweets|SearchTimeline|ListLatestTweetsTimeline|GenericTimelineById|ExploreSidebar|ExplorePage|ConnectTabTimeline|CommunityTweetsTimeline|CommunitiesExploreTimeline|Likes|BookmarkSearchTimeline|Bookmarks|NotificationsTimeline|ImmersiveMedia|TrendHistory|ForYouExplore)(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/YOUR_NAME/YOUR_REPO/main/x-adblock.js

[MITM]
hostname = %APPEND% api.x.com, api.twitter.com, x.com, twitter.com
